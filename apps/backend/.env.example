# Generate a random value with at least 32 characters before starting the service.
ATLAS_COMPANION_TOKEN=replace-with-a-random-token-of-at-least-32-characters

# Optional: enables POST /v1/search via Brave Search. This key is read only by
# the local companion and is never accepted from or forwarded by the extension.
ATLAS_BRAVE_SEARCH_API_KEY=
