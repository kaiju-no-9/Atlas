{
  "name": "atlas-browser-agent",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm --filter @atlas/extension dev",
    "build": "pnpm --filter @atlas/contracts typecheck && pnpm --filter @atlas/extension build",
    "typecheck": "pnpm --filter @atlas/contracts typecheck && pnpm --filter @atlas/extension typecheck",
    "test": "pnpm --filter @atlas/extension test",
    "lint": "pnpm --filter @atlas/extension lint",
    "eval": "node evals/run-fixtures.mjs --check"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
